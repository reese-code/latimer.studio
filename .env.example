# Sanity project ID/dataset from sanity.io/manage — safe to expose to the
# client, these just identify which dataset to read.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Write-capable API token, used only by scripts/migrate-to-sanity.mjs
# (a Node script, never bundled into the client build). Generate at
# sanity.io/manage -> your project -> API -> Tokens -> Add API token
# ("Editor" permission is enough). Never commit the real value.
SANITY_WRITE_TOKEN=
